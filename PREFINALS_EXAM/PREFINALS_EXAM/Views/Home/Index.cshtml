@model PREFINALS_EXAM.Models.ExamViewModel

@{
    ViewData["Title"] = "Prefinals Exam";
}

<style>
    :root {
        --bg-dark: #090d16;
        --card-bg: rgba(18, 24, 38, 0.75);
        --card-border: rgba(255, 255, 255, 0.08);
        --grad-primary: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
        --grad-accent: linear-gradient(135deg, #0ea5e9 0%, #2563eb 100%);
        --grad-success: linear-gradient(135deg, #10b981 0%, #059669 100%);
        --text-main: #f8fafc;
        --text-sub: #94a3b8;
    }

    body {
        background-color: var(--bg-dark);
        color: var(--text-main);
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* Hero Banner with Modern Gradient Glow */
    .hero-banner {
        position: relative;
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 2.5rem 1.5rem;
        margin-bottom: 2.5rem;
        overflow: hidden;
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    }

        .hero-banner::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--grad-primary);
        }

    .header-title {
        background: linear-gradient(135deg, #ffffff 30%, #c084fc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .student-badge {
        display: inline-block;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(168, 85, 247, 0.15) 100%);
        border: 1px solid rgba(168, 85, 247, 0.3);
        color: #e9d5ff;
        font-weight: 600;
        padding: 0.5rem 1.25rem;
        border-radius: 50px;
        box-shadow: 0 4px 12px rgba(168, 85, 247, 0.1);
    }

    /* Glassmorphism Exam Cards */
    .exam-card {
        background: var(--card-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--card-border);
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        transition: all 0.25s ease;
        position: relative;
    }

        .exam-card:hover {
            transform: translateY(-3px);
            border-color: rgba(99, 102, 241, 0.3);
            box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.4);
        }

    .item-number {
        background: var(--grad-accent);
        color: #ffffff;
        font-size: 0.8rem;
        font-weight: 700;
        padding: 0.3rem 0.85rem;
        border-radius: 8px;
        letter-spacing: 0.5px;
    }

    .option-pill {
        padding: 0.65rem 1rem;
        border-radius: 10px;
        margin-bottom: 0.4rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.04);
        font-size: 0.93rem;
        color: var(--text-sub);
        transition: background 0.2s ease;
    }

        .option-pill.correct {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(5, 150, 105, 0.2) 100%);
            border: 1px solid rgba(16, 185, 129, 0.4);
            color: #34d399;
            font-weight: 600;
        }

    .answer-footer {
        padding-top: 0.8rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .answer-text {
        color: #34d399;
        font-weight: 700;
        font-size: 0.92rem;
    }

    .section-title {
        background: linear-gradient(135deg, #f8fafc 0%, #94a3b8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 700;
    }
</style>

<div class="hero-banner text-center">
    <h1 class="header-title display-6 mb-2">
        IT ELECTIVE 2 – PREFINALS EXAMINATION
    </h1>
    <p class="text-secondary mb-3 fs-5">
        Web System and Technologies
    </p>
    <div class="student-badge">
        Raven Joe R. Albaño BSIT - 31E2
    </div>
</div>

<div class="mb-4">
    <h3 class="section-title mb-4">Multiple Choice Answers</h3>

    <div class="row">
        @foreach (var item in Model.Questions)
        {
            <div class="col-12 col-md-6 d-flex align-items-stretch">
                <div class="exam-card w-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="item-number">Question #@item.Id</span>
                        </div>

                        <p class="fw-semibold text-white mb-3" style="white-space: pre-line; line-height: 1.5; font-size: 1rem;">
                            @item.Question
                        </p>

                        <div class="options-container mb-3">
                            @foreach (var option in item.Options)
                            {
                                bool isCorrect = option.StartsWith(item.CorrectAnswer.ToString());
                                <div class="option-pill @(isCorrect ? "correct" : "")">
                                    @option
                                </div>
                            }
                        </div>
                    </div>

                    <div class="answer-footer d-flex justify-content-between align-items-center">
                        <small class="text-secondary">Correct Answer:</small>
                        <span class="answer-text">@item.AnswerText</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>